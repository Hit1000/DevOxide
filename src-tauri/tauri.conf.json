{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevOxide",
  "version": "0.1.13",
  "identifier": "DevOxide Desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevOxide",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#09090b",
        "shadow": false,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Hit1000",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
